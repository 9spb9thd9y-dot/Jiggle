-- // Hop to Random Server
ServerTab:CreateButton({
    Name = "Hop to Random Server",
    Callback = function()
        Notify("Server", "Finding server...", 2)
        task.spawn(function()
            local ok, err = pcall(function()
                local servers = {}
                local req = (http_request or request or http.request)
                if not req then
                    Notify("Server", "HTTP not supported by executor", 3)
                    return
                end

                local cursor = ""
                for attempt = 1, 5 do
                    local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100" .. (cursor ~= "" and "&cursor=" .. cursor or "")
                    local response = req({Url = url, Method = "GET"})
                    local data = HttpService:JSONDecode(response.Body)

                    for _, server in ipairs(data.data) do
                        if server.id ~= game.JobId and server.playing < server.maxPlayers then
                            table.insert(servers, server.id)
                        end
                    end

                    cursor = data.nextPageCursor or ""
                    if cursor == "" then break end
                end

                if #servers > 0 then
                    local target = servers[math.random(1, #servers)]
                    Notify("Server", "Hopping to: " .. target, 2)
                    task.wait(0.5)
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, target, player)
                else
                    Notify("Server", "No servers found", 3)
                end
            end)
            if not ok then
                Notify("Server", "Hop failed: " .. tostring(err), 3)
            end
        end)
    end
})

-- // Hop to Least Players Server
ServerTab:CreateButton({
    Name = "Hop to Least Players Server",
    Callback = function()
        Notify("Server", "Scanning for emptiest server...", 2)
        task.spawn(function()
            local req = (http_request or request or http.request)
            if not req then Notify("Server", "HTTP not supported", 3) return end
            local best, bestCount = nil, math.huge
            local cursor = ""
            for attempt = 1, 3 do
                local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100" .. (cursor ~= "" and "&cursor=" .. cursor or "")
                local ok, data = pcall(function()
                    return HttpService:JSONDecode(req({Url = url, Method = "GET"}).Body)
                end)
                if ok and data.data then
                    for _, server in ipairs(data.data) do
                        if server.id ~= game.JobId and server.playing < bestCount then
                            bestCount = server.playing
                            best = server.id
                        end
                    end
                end
                cursor = (ok and data.nextPageCursor) or ""
                if cursor == "" then break end
            end
            if best then
                Notify("Server", "Joining server with " .. bestCount .. " players", 2)
                task.wait(0.5)
                TeleportService:TeleportToPlaceInstance(game.PlaceId, best, player)
            else
                Notify("Server", "No servers found", 3)
            end
        end)
    end
})

