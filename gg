local function DiscoverFlaggedRemote()
    local _v2 = {
        ReplicatedStorage.Util, ReplicatedStorage.Common, ReplicatedStorage.Remotes,
        ReplicatedStorage.Assets, ReplicatedStorage.FX,
    }
    for _, folder in ipairs(_v2) do
        if folder then
            for _, child in ipairs(folder:GetChildren()) do
                if child:IsA("RemoteEvent") and child:GetAttribute("Id") then
                    u5_flagged = child:GetAttribute("Id")
                    u4_flagged = child
                end
            end
        end
    end
end
DiscoverFlaggedRemote()

local function StopFlaggedM1()
    if FlaggedM1Connection then FlaggedM1Connection:Disconnect(); FlaggedM1Connection = nil end
end

local function DoFlaggedFastAttack()
    if not RegisterHit then return end
    local _Character = player.Character
    if not _Character then return end
    local _HRP = _Character:FindFirstChild("HumanoidRootPart")
    if not _HRP then return end
    local _Tool = _Character:FindFirstChildOfClass("Tool")
    if not _Tool then return end

    local wt = _Tool:GetAttribute("WeaponType")
    if wt ~= "Melee" and wt ~= "Sword" then return end

    local _targets = {}
    local enemies = workspace:FindFirstChild("Enemies")
    local chars = workspace:FindFirstChild("Characters")

    local function checkFolder(folder)
        if not folder then return end
        for _, v in ipairs(folder:GetChildren()) do
            if v ~= _Character then
                local vHRP = v:FindFirstChild("HumanoidRootPart")
                local vHum = v:FindFirstChild("Humanoid")
                if vHRP and vHum and vHum.Health > 0 and (vHRP.Position - _HRP.Position).Magnitude <= FlaggedRange then
                    _targets[#_targets + 1] = {v, vHRP}
                end
            end
        end
    end

    checkFolder(enemies)
    checkFolder(chars)

    if #_targets > 0 then
        pcall(function()
            if NetModule then NetModule:RemoteEvent("RegisterHit", true) end
            if RegisterAttack then RegisterAttack:FireServer() end
            local _Head = _targets[1][1]:FindFirstChild("Head")
            if _Head then
                local threadId = tostring(player.UserId):sub(2, 4) .. tostring(coroutine.running()):sub(11, 15)
                RegisterHit:FireServer(_Head, _targets, {}, threadId)

                if u4_flagged then
                    local seedRemote = Net:FindFirstChild("seed")
                    local seedVal = 0
                    if seedRemote then pcall(function() seedVal = seedRemote:InvokeServer() end) end
                    local fireRemote = cloneref(u4_flagged) or ReplicatedStorage:FindFirstChild(u4_flagged.Name) or u4_flagged

                    local gsubResult = string.gsub("RE/RegisterHit", ".", function(c)
                        local byteVal = string.byte(c)
                        local timeVal = math.floor(getServerTime() / 10 % 10)
                        return string.char(bit32.bxor(byteVal, timeVal + 1))
                    end)

                    fireRemote:FireServer(gsubResult, bit32.bxor(u5_flagged + 909090, seedVal * 2), _Head, _targets)
                end
            end
        end)
    end
end

local function StartFlaggedM1()
    StopFlaggedM1()
    FlaggedM1Connection = RunService.Heartbeat:Connect(function()
        if not (Config.FlaggedM1 and Config.IsRunning) then StopFlaggedM1() return end
        pcall(DoFlaggedFastAttack)
    end)
end

