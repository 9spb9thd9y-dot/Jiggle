local TweenConnection = nil

local function StopTween()
    if TweenConnection then TweenConnection:Disconnect(); TweenConnection = nil end
    if ActiveTween then ActiveTween:Cancel(); ActiveTween = nil end
end

local function GetNearestPlayerHRP(myHRP)
    local nearest = nil
    local nearestDist = math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and not IsAlly(p) and p.Character then
            local char = p.Character
            if IsInCombat(p, char) then
                local hum = char:FindFirstChild("Humanoid")
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hum and hrp and hum.Health > 0 then
                    local dist = (hrp.Position - myHRP.Position).Magnitude
                    if dist < nearestDist then
                        nearestDist = dist
                        nearest = hrp
                    end
                end
            end
        end
    end
    return nearest
end

local function StartTween()
    StopTween()
    TweenConnection = RunService.Heartbeat:Connect(function()
        if not (Config.TweenToPlayer or Config.TweenToNearest) then StopTween() return end

        local myChar = player.Character
        local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myHRP then return end

        local tHRP = nil

        if Config.TweenToPlayer then
            local target = SelectedPlayer and Players:FindFirstChild(SelectedPlayer)
            if target and target.Character then
                tHRP = target.Character:FindFirstChild("HumanoidRootPart")
            end
        elseif Config.TweenToNearest then
            tHRP = GetNearestPlayerHRP(myHRP)
        end

        if tHRP then
            local dist = (myHRP.Position - tHRP.Position).Magnitude
            if dist <= 100000 then
                local targetVel = tHRP.AssemblyLinearVelocity
                local timeToArrive = math.max(0.01, dist / TweenSpeedVal)
                local predictedPos = tHRP.Position + (targetVel * timeToArrive)
                local targetPos = predictedPos + Vector3.new(0, Config.YOffset, 0)
                local targetCFrame = CFrame.new(targetPos)

                if not ActiveTween or ActiveTween.PlaybackState ~= Enum.PlaybackState.Playing or (LastTargetPos - targetPos).Magnitude > 5 then
                    if ActiveTween then ActiveTween:Cancel() end
                    myHRP.AssemblyLinearVelocity = Vector3.new(0,0,0)
                    ActiveTween = TweenService:Create(myHRP, TweenInfo.new(timeToArrive, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
                    ActiveTween:Play()
                    LastTargetPos = targetPos
                end
            end
        end
    end)
end

